# ==============================================================================
# RePrompt Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------------------------
# Required for server-side multimodal vision and prompt reverse-engineering.
# In AI Studio preview and Google Cloud Run, this is automatically provided.
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# 1. Browser Client (Vite-exposed public variables)
# These are safe to expose to the client browser bundles.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# 2. Cloudflare Turnstile CAPTCHA (Public Site Key Only)
# Safe to expose to the client browser bundle. Supabase holds the Turnstile Secret Key.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAFPmbCnYtVFfMVu_"

# 3. Server Backend (server.ts)
# The service-role key gives administrative privileges to execute atomic usage
# RPCs and verify user JWTs. NEVER prefix with VITE_ and NEVER expose to the browser!
SUPABASE_URL="https://jjprkyfiizcowxkjafzl.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpqcHJreWZpaXpjb3d4a2phZnpsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEzMDA5MTksImV4cCI6MjEwNjg3NjkxOX0.xgD7SGgllqSuhCr_Gn9_e2aLRnb7MV74wsrBbEqOtvQ"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpqcHJreWZpaXpjb3d4a2phZnpsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MTMwMDkxOSwiZXhwIjoyMTA2ODc2OTE5fQ.FEhDhytHbCbkisE3QBAsZD3GOEg59uWvphJcSuGvHkU"

# ------------------------------------------------------------------------------
# Application & Deployment
# ------------------------------------------------------------------------------
# Canonical URL for SEO sitemap, OpenGraph tags, and robots.txt
APP_URL="https://your-production-domain.com"

# Server runtime mode
NODE_ENV="production"
PORT=3000
