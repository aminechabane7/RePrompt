# ==============================================================================
# RePrompt Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API
# ------------------------------------------------------------------------------
# Required for server-side multimodal vision and prompt reverse-engineering.
# In AI Studio preview and Google Cloud Run, this is automatically provided.
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# Supabase Configuration (Frontend - REQUIRED IN VERCEL)
# ------------------------------------------------------------------------------
# These variables MUST start with VITE_ to be embedded into the browser bundle by Vite.
# Safe to expose publicly to client browsers.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-public-anon-key"

# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (Frontend - REQUIRED IN VERCEL)
# ------------------------------------------------------------------------------
# Safe public site key for Turnstile widget.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAFPmbCnYtVFfMVu_"

# ------------------------------------------------------------------------------
# Supabase Configuration (Server Backend ONLY)
# ------------------------------------------------------------------------------
# The service-role key gives administrative privileges to execute atomic usage
# RPCs and verify user JWTs. NEVER prefix with VITE_ and NEVER expose to the browser!
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ------------------------------------------------------------------------------
# Application & Deployment
# ------------------------------------------------------------------------------
# Canonical URL for SEO sitemap, OpenGraph tags, and robots.txt
APP_URL="https://your-production-domain.com"

# Server runtime mode
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# Anti-Abuse & Quota Management (Server Backend ONLY)
# ------------------------------------------------------------------------------
# Shared atomic global Gemini API cap across all users and Vercel instances per UTC day.
# Defaults to 20 attempts per day if unset.
DAILY_BETA_CAP="20"
